# Copy values from findependence-core/.env and fi-plan-fe tracker keys.
# This file is gitignored — do not commit secrets.

# --- Database ---
DB_URL=
DB_NAME=findependence

# --- App ---
NODE_ENV=development
CLIENT_APPLICATION=http://localhost:3001
DEFAULT_PLAN_DURATION=600
SESSION_TIMEOUT=24
PW_RESET_SESSION_LENGTH=30

# --- Cookies / sessions ---
COOKIE_SECRET=
COOKIE_SEC=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PASSPORT_CALLBACK_URL=http://localhost:3001/api/oauth/google/callback

# --- Mailjet (password reset emails) ---
MJ_APIKEY_PUBLIC=
MJ_APIKEY_PRIVATE=
SUPPORT_MAIL=
MAILER_NAME=

# --- IndMoney MCP (net worth) ---
INDMONEY_MCP_URL=https://mcp.indmoney.com/mcp

# --- AI assistant (in-app) ---
# Anthropic-format API key. DeepSeek works too: set the key from
# platform.deepseek.com and point AI_BASE_URL at DeepSeek's
# Anthropic-compatible endpoint (see docs/mcp-usage.md).
ANTHROPIC_API_KEY=
AI_PROVIDER=anthropic
AI_BASE_URL=https://api.anthropic.com
AI_MODEL=claude-3-5-sonnet-latest

# --- MCP endpoint (external agents) ---
# Gate the /api/mcp endpoint; stdio entry (npm run mcp:stdio) authenticates
# with a single API token minted in the app (Profile -> API Tokens).
MCP_ENABLED=true
FIPLAN_API_TOKEN=
